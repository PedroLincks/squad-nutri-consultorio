# Copie para .env.local. Sem SUPABASE_URL, o `npm run dev` usa um banco simulado em .dev-data/db.json
# (carregado de supabase/seed.json) — bom para testar sem o Supabase. BANCO_SIMULADO=1 npm run dev força isso (senha do admin: dev).

# Projeto Supabase EXCLUSIVO deste app — só no servidor, NUNCA com prefixo VITE_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha da tela /admin — use uma senha forte (12+ caracteres, sem palavra comum)
ADMIN_SENHA=

# Segredo que assina os cookies de sessão (64 caracteres aleatórios). Gerar com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões abertas.
SESSAO_SEGREDO=

# Chave que cifra a cópia das senhas das vendedoras (botão "Ver senha"). Gerar com: openssl rand -base64 48
# NÃO trocar depois de definir senhas: as cópias antigas deixam de abrir (o login continua funcionando).
SENHAS_CHAVE=

# Domínio público dos links curtos (mostrado na tela das vendedoras)
VITE_DOMINIO=https://sales.nutrideconsultorio.com
